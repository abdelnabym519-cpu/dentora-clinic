# DentalPin — Client local production install
# Copy this file to .env.client before first start.

# Same-PC access. For clinic LAN access, replace localhost with the PC's fixed LAN IP,
# for example: http://192.168.1.50
PUBLIC_URL=http://localhost

# PostgreSQL
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=

# Generate both with: openssl rand -hex 32
SECRET_KEY=
BUDGET_PUBLIC_SECRET_KEY=

# Optional AI Copilot. Leave blank if not used.
OPENAI_API_KEY=
