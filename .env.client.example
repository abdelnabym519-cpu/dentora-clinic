# Dentora — reusable local clinic installation
# START_DENTORA.bat creates .env.client from this template on first run.
# Never copy an existing .env.client from one clinic to another.

# Same-PC access. For clinic LAN access, replace localhost in the generated
# .env.client with the server PC's fixed LAN IP, for example: http://192.168.1.50
PUBLIC_URL=http://dentora.local

# PostgreSQL
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=

# Release identity. Images are immutable digest references, never `latest`.
DENTORA_VERSION=2.0.0
DENTORA_BACKEND_IMAGE=ghcr.io/abdelnabym519-cpu/dentora-clinic-backend:2.0.0
DENTORA_FRONTEND_IMAGE=ghcr.io/abdelnabym519-cpu/dentora-clinic-frontend:2.0.0
DENTORA_RELEASE_REPOSITORY=abdelnabym519-cpu/dentora-clinic

# Persistent Docker volumes. New installations use the Dentora-only defaults
# declared by docker-compose.client.yml. Existing installations set the
# inspected physical names only in their untracked .env.client and use the
# existing-volumes overlay; never recreate or delete a data volume to rebrand.
DENTORA_POSTGRES_VOLUME=
DENTORA_STORAGE_VOLUME=
DENTORA_CADDY_DATA_VOLUME=
DENTORA_CADDY_CONFIG_VOLUME=

# Generated automatically on the first start.
SECRET_KEY=
BUDGET_PUBLIC_SECRET_KEY=

# Commercial activation. The production server URL and Ed25519 public key are
# injected before a commercial Generic Client package is released.
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY_B64=
# Generated automatically from the Windows host on first start.
LICENSE_MACHINE_FINGERPRINT=

# AI Copilot uses the owner-controlled Dentora AI Gateway.
# Never place an OpenAI provider key on a client machine.
# Optional override; production normally derives this from LICENSE_SERVER_URL.
AI_GATEWAY_BASE_URL=
