# Copy to .env.evolution for the optional docker-compose.evolution.yml stack.
# Never commit the real file or real credentials.
#
# Current stable inspected on 2026-08-28 is Evolution API 2.3.7, but an open
# upstream security issue reports that its Baileys rc.9 dependency is affected
# by CVE-2026-48063. Intentionally choose a reviewed/patched Evolution API v2
# image for your environment rather than blindly using `latest` or 2.3.7.
EVOLUTION_API_IMAGE=

# Generate strong local secrets. Do not reuse Dentora SECRET_KEY.
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=

# Optional local overrides.
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
