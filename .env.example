# Database (for Docker Compose)
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=your_secure_password_here

# Backend (for local development without Docker)
# DATABASE_URL is auto-constructed in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://dental:your_secure_password_here@localhost:5432/dental_clinic

# Optional Dental 3D Phase 5.2 model service. Leave URL empty to return the
# explicit missing_model outcome; production URLs must use HTTPS.
DENTAL_3D_NERVE_INFERENCE_URL=
DENTAL_3D_NERVE_INFERENCE_TOKEN=
DENTAL_3D_NERVE_INFERENCE_TIMEOUT_SECONDS=120
DENTAL_3D_NERVE_MAX_INSTANCES=512
DENTAL_3D_NERVE_MAX_INPUT_BYTES=268435456
DENTAL_3D_NERVE_LOW_CONFIDENCE_THRESHOLD=0.6

# Optional local DentalSegmentator service used only with
# docker-compose.nerve-ai.yml. Point this at the exact nnU-Net model folder
# containing dataset.json, plans.json and fold_0/checkpoint_final.pth.
# On Windows use forward slashes, e.g. C:/Dentora/Models/.../nnUNetTrainer__...
DENTORA_NERVE_MODEL_HOST_DIR=
DENTORA_NERVE_SERVICE_TOKEN=
DENTORA_NERVE_DEVICE=cpu
DENTORA_NERVE_CPU_THREADS=12
DENTORA_NERVE_MAX_REQUEST_BYTES=268435456
# Conservative default: do not suppress any connected component by size.
DENTORA_NERVE_MIN_COMPONENT_VOXELS=1
# Fail closed for production until the external model/weights commercial-use
# gate has been separately reviewed and explicitly approved.
DENTORA_NERVE_COMMERCIAL_USE_APPROVED=false

# Optional operator-managed DentalSegmentator service plus deterministic
# Open3D/TEASER++/ICP engineering parameters. IOS units are supplied per run.
DENTAL_3D_DENTAL_SEGMENTATOR_URL=
DENTAL_3D_DENTAL_SEGMENTATOR_TOKEN=
DENTAL_3D_DENTAL_SEGMENTATOR_TIMEOUT_SECONDS=900
DENTAL_3D_REGISTRATION_MAX_INSTANCES=512
DENTAL_3D_REGISTRATION_MAX_INPUT_BYTES=268435456
DENTAL_3D_REGISTRATION_VOXEL_SIZE_MM=1.0
DENTAL_3D_REGISTRATION_GLOBAL_DISTANCE_MM=3.0
DENTAL_3D_REGISTRATION_ICP_DISTANCE_MM=1.5
DENTAL_3D_REGISTRATION_ICP_MAX_ITERATIONS=50

# AI providers (one LLM abstraction — see docs/ai-activation.md)
#
# COPILOT_PROVIDER_DEFAULT routes every clinical-AI generation endpoint
# (case summary, case intelligence, treatment planning, second review,
# clinical report, copilot) through app/core/llm/.
#
# Leave it EMPTY (the default) and ENVIRONMENT decides:
#   development / anything else -> "ollama"      fully local, no API key
#   production                  -> "cloudflare"  Workers AI, needs
#                                CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
# Set it explicitly to pin "openai" (needs OPENAI_API_KEY), "ollama" or
# "cloudflare" regardless of environment. A clinic's own `copilot_settings`
# row overrides this at runtime.
#
# This used to default to "openai" with an empty OPENAI_API_KEY, so a fresh
# local stack sent every AI request to OpenAI with no credential and the UI
# could only report a bare "Connection error".
# COPILOT_PROVIDER_DEFAULT=

# Local Ollama. The backend runs in a container, where `localhost` is the
# container itself — use host.docker.internal, which docker-compose.yml maps
# via `extra_hosts: host.docker.internal:host-gateway`. All three of these
# must hold on the host, or every AI call fails:
#   1. Ollama is running          curl http://localhost:11434/api/tags
#   2. It listens beyond loopback OLLAMA_HOST=0.0.0.0 (the default binds
#                                 127.0.0.1, unreachable from a container)
#   3. The model is pulled        ollama pull qwen3:8b
# Diagnose all of it from inside the container, including a real completion:
#   docker compose exec backend python -m scripts.diagnose_ai_provider --probe
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1/
# COPILOT_MODEL_CHAT_OLLAMA=qwen3:8b
# COPILOT_TIMEOUT_SECONDS=120

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32

# Independent secret for the public-budget verification cookie
# (see docs/adr/0006-budget-public-link-2-factor-auth.md).
# Generate with: openssl rand -hex 32. Falls back to SECRET_KEY in
# dev when unset; production deploys must set it explicitly.
BUDGET_PUBLIC_SECRET_KEY=

# Environment
ENVIRONMENT=development
# Frontend is published on http://localhost:3100 (compose "3100:3000").
# For a phone/LAN device use http://<host-lan-ip>:3100.
ALLOWED_ORIGINS=http://localhost:3100

# Frontend
API_BASE_URL=http://localhost:8100
