# Dentora — production. Copy to .env next to docker-compose.prod.yml.

# Public address of your install. Use https:// with a domain that already
# points at this server and Caddy provisions TLS on first boot.
# For a local trial, use http://localhost explicitly.
PUBLIC_URL=https://clinic.example.com

# Required in production. Pin an immutable released version; do not use latest.
DENTORA_VERSION=

# Database
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=

# Generate each independently with: openssl rand -hex 32
SECRET_KEY=
BUDGET_PUBLIC_SECRET_KEY=

# AI Copilot (optional). Without it the app runs, the assistant does not.
OPENAI_API_KEY=

# AI Copilot — Cloudflare Workers AI provider (optional). Set the
# account id + an API token with the "Workers AI" read scope to enable
# provider "cloudflare" (official OpenAI-compatible endpoint at
# https://api.cloudflare.com/<CLOUDFLARE_ACCOUNT_ID>/ai/v1).
# New clinics default to it when COPILOT_PROVIDER_DEFAULT=cloudflare.
# Existing clinics switch via the copilot settings panel (PATCH
# /api/v1/copilot/settings {"provider": "cloudflare"}).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Load the demo clinic on first boot to look around before going live.
# admin@demo.clinic / demo1234. Leave at 0 for a real clinic.
SEED_ON_STARTUP=0
SEED_LANG=es
