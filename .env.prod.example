# Dentora — production. Copy to .env next to docker-compose.prod.yml.

# Public address of your install. Use https:// with a domain that already
# points at this server and Caddy provisions TLS on first boot.
# For a local trial, leave it as http://localhost.
PUBLIC_URL=https://clinic.example.com

# Pin a release instead of tracking latest once you are in production.
DENTORA_VERSION=latest

# Database
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=

# Generate each with: openssl rand -hex 32
SECRET_KEY=
BUDGET_PUBLIC_SECRET_KEY=

# AI Copilot. Default deployment uses the bundled, fully-local Ollama
# service (no cloud, no API key). The `ollama` compose service builds
# `dentora-qwen3:1.7b` from qwen3:1.7b on first boot.
COPILOT_PROVIDER_DEFAULT=ollama
OLLAMA_MODEL=dentora-qwen3:1.7b
# Inside Docker the backend reaches Ollama via the compose service name:
OLLAMA_BASE_URL=http://ollama:11434
# To instead use an Ollama server running on the host machine, set
# OLLAMA_BASE_URL=http://host.docker.internal:11434 (and the ollama
# compose service is then unused).
# Cloud OpenAI remains available by setting COPILOT_PROVIDER_DEFAULT=openai
# and the key below.
OPENAI_API_KEY=

# Load the demo clinic on first boot to look around before going live.
# admin@demo.clinic / demo1234. Leave at 0 for a real clinic.
SEED_ON_STARTUP=0
SEED_LANG=es
