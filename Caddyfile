# Single origin for the whole app. PUBLIC_URL doubles as the site
# address: give it an https host and Caddy provisions the certificate
# itself; leave it at http://localhost and it serves plain HTTP.
#
# The backend is discovered through Docker DNS on every refresh interval so
# replicas added/removed by the autoscaling controller enter/leave rotation
# without restarting Caddy.

{$PUBLIC_URL:http://localhost} {
	handle /api/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			fail_duration 30s
			max_fails 2
			lb_try_duration 5s
			lb_try_interval 250ms
			# The copilot streams SSE; without this Caddy buffers the
			# response and the chat appears frozen until the turn ends.
			flush_interval -1
		}
	}

	handle /health* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
			fail_duration 30s
			max_fails 2
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	encode gzip
}
