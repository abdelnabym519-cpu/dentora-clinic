# PostgreSQL database for the commercial license service.
DATABASE_URL=postgresql+asyncpg://license:change-me@localhost:5432/dentora_license

# Long random secret used only for owner/admin license-management endpoints.
LICENSE_ADMIN_API_KEY=

# Base64-encoded PEM PKCS8 Ed25519 private key. Never distribute this to clients.
LICENSE_SIGNING_PRIVATE_KEY_B64=

# Signed lease policy.
LICENSE_REFRESH_HOURS=24
LICENSE_OFFLINE_GRACE_DAYS=7
