{
  "name": "dentora-license-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Dentora commercial license service on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dentora-license --local",
    "db:migrate:remote": "wrangler d1 migrations apply dentora-license --remote",
    "test:ai-gateway": "node --test tests/ai-gateway.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.44.0"
  },
  "type": "module"
}
